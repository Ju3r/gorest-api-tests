    {
      "name": "Testing scenarios",
      "item": [
        {
          "name": "Create User and verify",
          "item": [
            {
              "name": "GET /users?email={{SCENARIO_USER_EMAIL}} (check before creation: user does not exist)",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const countOfEmailLetter = 15;\r\nconst startSubstringCount = 2;\r\nconst endSubstringCount = 15;\r\n\r\nconst qaPrefix = 'aqa.'\r\nconst emailPrefix = Math.random().toString(countOfEmailLetter).substring(startSubstringCount, endSubstringCount);\r\nconst emailPostfix = '@test.com';\r\n\r\nconst email = qaPrefix + emailPrefix + emailPostfix;\r\n\r\npm.environment.set(\"SCENARIO_USER_EMAIL\", email);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const statusCodeSuccess = 200;\r\nconst outOfUsers = 0;\r\nconst users = pm.response.json();\r\n\r\npm.test(`Status code is ${statusCodeSuccess}`, function () {\r\n    pm.response.to.have.status(statusCodeSuccess);\r\n});\r\n\r\npm.test(\"No user with the generated email exists before POST\", function () {\r\n    pm.expect(users.length, \"filtered results for the generated email\").to.eql(outOfUsers);\r\n});"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{BEARER_TOKEN}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{BASE_URL}}/users?email={{SCENARIO_USER_EMAIL}}",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "users"
                  ],
                  "query": [
                    {
                      "key": "email",
                      "value": "{{SCENARIO_USER_EMAIL}}"
                    }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "POST /users (create)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const createdUser = pm.response.json();\r\n\r\npm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Get ID\", function () {\r\n    const id = createdUser.id;\r\n\r\n    pm.environment.set(\"SCENARIO_USER_ID\", id);\r\n});\r\n\r\npm.test(\"Response contains the generated user data and an ID\", function () {\r\n    pm.expect(createdUser.email).to.eql(pm.environment.get(\"SCENARIO_USER_EMAIL\"));\r\n    pm.expect(createdUser.name).to.eql(pm.environment.get(\"SCENARIO_USER_NAME\"));\r\n    pm.expect(createdUser.gender).to.eql(pm.environment.get(\"SCENARIO_USER_GENDER\"));\r\n    pm.expect(createdUser.status).to.eql(pm.environment.get(\"SCENARIO_USER_STATUS\"));\r\n    pm.expect(createdUser.id).to.exist;\r\n});\r\n"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{BEARER_TOKEN}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n    \"name\": \"{{SCENARIO_USER_NAME}}\",\r\n    \"email\": \"{{SCENARIO_USER_EMAIL}}\",\r\n    \"gender\": \"{{SCENARIO_USER_GENDER}}\",\r\n    \"status\": \"{{SCENARIO_USER_STATUS}}\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{BASE_URL}}/users",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "users"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "GET /users?email={{SCENARIO_USER_EMAIL}} (check after creation)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const statusCodeSuccess = 200;\r\nconst users = pm.response.json();\r\nconst userIndex = 0;\r\nconst correctLengthOfArray = 1;\r\n\r\npm.test(`Status code is ${statusCodeSuccess}`, function () {\r\n    pm.response.to.have.status(statusCodeSuccess);\r\n});\r\n\r\npm.test(\"Only one user with the generated email exists\", function () {\r\n    pm.expect(users.length, \"filtered results for the generated email\").to.eql(correctLengthOfArray);\r\n});\r\n\r\npm.test(\"Created user appears in the list\", function () {\r\n    const scenarioId = pm.environment.get(\"SCENARIO_USER_ID\");\r\n    pm.expect(String(users[userIndex].id)).to.eql(String(scenarioId));\r\n})"
                    ]
