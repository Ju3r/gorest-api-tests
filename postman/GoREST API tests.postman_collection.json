                      "const statusCodeSuccess = 200;\r\nconst user = pm.response.json();\r\n\r\npm.test(`Status code is ${statusCodeSuccess}`, function () {\r\n    pm.response.to.have.status(statusCodeSuccess);\r\n});\r\n\r\npm.test(\"GET by ID returns the user created in this scenario\", function () {\r\n    pm.expect(String(user.id)).to.eql(String(pm.environment.get(\"SCENARIO_USER_ID\")));\r\n    pm.expect(user.email).to.eql(pm.environment.get(\"SCENARIO_USER_EMAIL\"));\r\n    pm.expect(user.name).to.eql(pm.environment.get(\"SCENARIO_USER_NAME\"));\r\n    pm.expect(user.gender).to.eql(pm.environment.get(\"SCENARIO_USER_GENDER\"));\r\n    pm.expect(user.status).to.eql(pm.environment.get(\"SCENARIO_USER_STATUS\"));\r\n});"
